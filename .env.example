# Resonance Frontend Environment Variables

# The base URL of the Resonance API
# Local development: http://localhost:5000/api
# Production: https://resoanance-neondb.onrender.com/api
NEXT_PUBLIC_API_URL="http://localhost:5000/api"

# (Optional) If you decide to decouple and use Neon Auth directly from the frontend
# Note: Currently, the backend handles Better Auth, so NEXT_PUBLIC_API_URL is sufficient.
NEXT_PUBLIC_NEON_AUTH_URL="https://ep-soft-wildflower-azaj4iw6.neonauth.c-3.ap-southeast-1.aws.neon.tech/neondb/auth"
